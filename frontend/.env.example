# Business contact in international format (country code 977, no leading 0).
# Used for the WhatsApp Click-to-Chat link. VITE_ values are public in the browser bundle.
VITE_WHATSAPP_NUMBER=

# Display phone shown in the footer. Defaults to VITE_WHATSAPP_NUMBER when empty.
VITE_SHOP_PHONE=

# Optional: when set, booking requests are POSTed to `${VITE_API_BASE_URL}/booking-requests`.
# When empty, the app simulates the request locally (frontend-only mode).
VITE_API_BASE_URL=

# Demo admin password (client-side only, NOT secure). Real authentication needs a backend.
VITE_ADMIN_DEMO_PASSWORD=
